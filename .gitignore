# ── Dados brutos e derivados nunca vão para o repo (Constituição §6) ──
data/
*.zip
*.csv
*.ndjson
*.ndjson.gz
*.parquet
*.xlsx

# Excecoes: estes CSV/XLSX sao MODELO, nao dado. Sem eles um clone limpo nao
# roda `dbt seed` — foi exatamente o que quebrou o primeiro run do CI.
!dbt/seeds/*.csv
!tests/**/*.csv

# ── Site gerado ──
# Saida de `scripts/gerar_site.py`. E' derivado dos marts e refeito a cada
# execucao — versionar seria guardar 536 arquivos que o pipeline reproduz.
/site/

# ── Configuracao local do Claude Code ──
# Permissoes pessoais da maquina, incluindo operacoes destrutivas de git. Nao vao
# para um repositorio publico.
.claude/settings.local.json

# ── Segredos ──
.env
*.json.key
service-account*.json
gcp-key*.json

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ── dbt ──
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
# dbt/profiles.yml E' versionado: so' tem env_var(), nenhum segredo.

# ── Power BI ──
bi/**/.pbi/localSettings.json
bi/**/*.pbix
bi/**/cache.abf

# ── SO / editores ──
.DS_Store
Thumbs.db
.vscode/
.idea/

# dbt package lock gerado por `dbt deps`
dbt/package-lock.yml
