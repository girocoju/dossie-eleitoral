	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	annotation PBI_QueryOrder = ["dim_uf", "dim_cargo", "dim_tempo", "dim_indicador", "dim_partido", "dim_candidato", "fct_candidatura", "fct_mandato", "fct_indicador_uf_ano", "fct_mandato_indicador"]

ref table dim_uf
ref table dim_cargo
ref table dim_tempo
ref table dim_indicador
ref table dim_partido
ref table dim_candidato
ref table fct_candidatura
ref table fct_mandato
ref table fct_indicador_uf_ano
ref table fct_mandato_indicador

ref cultureInfo pt-BR
