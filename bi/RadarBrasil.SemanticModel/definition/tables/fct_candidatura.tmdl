table fct_candidatura
	/// Uma candidatura por linha. Grao: sq_candidato.
	lineageTag: 3ca76d79-7922-f5a3-a70c-68c73b7fb60c

	measure 'Candidaturas' = COUNTROWS(fct_candidatura)
		formatString: #,0
		lineageTag: ae99842d-5a36-7755-c1d4-8919560bd77e
		displayFolder: Contagem

	/// Concorrencia por vaga. Descritivo, nao avaliativo.
	measure 'Candidaturas por vaga' = DIVIDE([Candidaturas], [Vagas em disputa])
		formatString: #,0.0
		lineageTag: e9c80fc5-569e-1c88-42ee-7b4a2146cfb1
		displayFolder: Contagem

	/// Sobre o genero autodeclarado ao TSE.
	measure '% de mulheres' = DIVIDE(CALCULATE([Candidaturas], dim_candidato[genero] = "FEMININO"), [Candidaturas])
		formatString: 0.0%
		lineageTag: 67d33189-2a3c-0b0c-83bc-0889d62b5f37
		displayFolder: Perfil

	measure '% de reeleicao' = DIVIDE(CALCULATE([Candidaturas], fct_candidatura[is_reeleicao] = TRUE), [Candidaturas])
		formatString: 0.0%
		lineageTag: 1007508d-ac37-e05f-ace4-dd239e05cdda
		displayFolder: Perfil

	/// Mediana e quartis; a media e' dominada por poucos casos extremos.
	measure 'Bens declarados (mediana)' = MEDIAN(fct_candidatura[total_bens_declarados])
		formatString: #,0
		lineageTag: cf8bc2ee-0a4e-519a-1715-88ddfba87e8e
		displayFolder: Bens

	measure 'Bens declarados (3o quartil)' = PERCENTILE.INC(fct_candidatura[total_bens_declarados], 0.75)
		formatString: #,0
		lineageTag: 826c8a42-b683-da49-5bae-689c7fc85548
		displayFolder: Bens

	/// Rodape obrigatorio de toda pagina (Constituicao 0.3).
	measure 'Extraido em' = FORMAT(MAX(fct_candidatura[_extracted_at]), "dd/MM/yyyy HH:mm") & " UTC"
		lineageTag: 61cd243f-cec8-3b7e-30f6-a0ea813b2ef6
		displayFolder: Rodape

