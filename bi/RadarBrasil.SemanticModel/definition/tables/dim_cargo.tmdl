table dim_cargo
	/// Cargos do TSE com esfera, duracao de mandato e vagas em 2026.
	lineageTag: da117fa6-b51d-cde7-cb06-d8ea51861206

	/// Soma das vagas publicadas pelo TSE em consulta_vagas 2026.
	measure 'Vagas em disputa' = SUM(dim_cargo[vagas_2026])
		formatString: #,0
		lineageTag: 07164193-5747-1805-6bcb-617cf2ce799e

	column cod_cargo
		dataType: int64
		isHidden
		lineageTag: 2e61f0be-82d4-3e50-3990-3e011cab14f2
		summarizeBy: none
		sourceColumn: cod_cargo

		annotation SummarizationSetBy = Automatic

	column descricao
		dataType: string
		lineageTag: 34a2cc7a-955a-4723-6240-53505aef4ab5
		summarizeBy: none
		sourceColumn: descricao

		annotation SummarizationSetBy = Automatic

	column esfera
		dataType: string
		lineageTag: 7061a77d-ebb0-df6b-ae2a-9332a7ade550
		summarizeBy: none
		sourceColumn: esfera

		annotation SummarizationSetBy = Automatic

	column duracao_mandato_anos
		dataType: int64
		lineageTag: 64fc7425-14bd-b648-d8fa-298ac2f29634
		summarizeBy: none
		sourceColumn: duracao_mandato_anos

		annotation SummarizationSetBy = Automatic

	column titular
		dataType: boolean
		lineageTag: 655e0502-89dc-501e-c410-a7e009c455af
		summarizeBy: none
		sourceColumn: titular

		annotation SummarizationSetBy = Automatic

	column no_escopo_mvp
		dataType: boolean
		lineageTag: ec4be602-9710-0e86-52fe-97a8f1292a36
		summarizeBy: none
		sourceColumn: no_escopo_mvp

		annotation SummarizationSetBy = Automatic

	/// TRUE so' para Presidente e Governador (SPEC 2.2).
	column modulo_durante_mandato
		dataType: boolean
		lineageTag: aa6f0869-d6a8-602f-fad8-d6388c86a718
		summarizeBy: none
		sourceColumn: modulo_durante_mandato

		annotation SummarizationSetBy = Automatic

	column vagas_2026
		dataType: int64
		formatString: #,0
		lineageTag: 0d720c6d-0e4b-8b73-c3d1-d6d88c58ca2b
		summarizeBy: sum
		sourceColumn: vagas_2026

		annotation SummarizationSetBy = Automatic

	partition dim_cargo = m
		mode: import
		source =
				let
				    Fonte = GoogleBigQuery.Database([BillingProject = ProjetoGCP]),
				    Projeto = Fonte{[Name = ProjetoGCP]}[Data],
				    Dataset = Projeto{[Name = DatasetMarts]}[Data],
				    Tabela = Dataset{[Name = "dim_cargo"]}[Data]
				in
				    Tabela

	annotation PBI_ResultType = Table
