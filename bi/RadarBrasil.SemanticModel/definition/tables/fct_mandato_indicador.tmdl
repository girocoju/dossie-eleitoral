table fct_mandato_indicador
	/// O que aconteceu com o indicador durante a janela do mandato. NAO mede efeito de gestao.
	lineageTag: 1d52480a-b3ee-a1c0-4077-56051b330009

	/// Variacao do indicador na UF entre as pontas da janela do mandato.
	measure 'Variacao no periodo (%)' = AVERAGE(fct_mandato_indicador[variacao_pct])
		formatString: #,0.0
		lineageTag: 7fd23a0b-83fe-ac34-a51e-bd4771a147df
		displayFolder: Durante o mandato

	measure 'Variacao no Brasil (%)' = AVERAGE(fct_mandato_indicador[variacao_brasil_pct])
		formatString: #,0.0
		lineageTag: 131838f7-c8cf-5368-a523-145684ecf712
		displayFolder: Durante o mandato

	/// Use esta, e nao a percentual, para RESULTADO_ORCAMENTARIO: e' o unico indicador que muda de sinal, e variacao percentual sobre base negativa e' indefinida (o modelo devolve NULL de proposito).
	measure 'Variacao no periodo (absoluta)' = AVERAGE(fct_mandato_indicador[variacao_abs])
		formatString: #,0.00
		lineageTag: 7c94109a-781f-28c3-9e20-62caed14d00b
		displayFolder: Durante o mandato

	/// Contraste descritivo entre duas variacoes. Nao e' placar.
	measure 'Diferenca vs. Brasil (p.p.)' = AVERAGE(fct_mandato_indicador[delta_vs_brasil])
		formatString: #,0.0
		lineageTag: 755669c8-1333-b98d-7252-11fe2b3c9484
		displayFolder: Durante o mandato

	/// Texto obrigatorio da pagina Durante o Mandato (F-06).
	measure 'Aviso metodologico' = "Indicadores refletem o periodo; nao medem o efeito do mandato." & IF(SELECTEDVALUE(fct_mandato_indicador[janela_incompleta]) = TRUE, " Serie termina antes do fim do mandato.", "")
		lineageTag: 5293ebeb-27e8-1e1c-0152-e07b310925dc
		displayFolder: Rodape

	/// Rodape obrigatorio (Constituicao 0.3).
	measure 'Fontes' = CONCATENATEX(VALUES(dim_indicador[fonte]), dim_indicador[fonte], " · ")
		lineageTag: 4924e4b1-2179-dc1d-4dae-676c3038cb10
		displayFolder: Rodape

