table fct_indicador_uf_ano
	/// Indicador x UF x ano, com o comparador nacional e regional na mesma linha.
	lineageTag: 8006ec49-0b08-3829-f903-8c32c47b7837

	measure 'Valor na UF' = AVERAGE(fct_indicador_uf_ano[valor])
		formatString: #,0.00
		lineageTag: bc10e9b5-0075-a9c0-4c66-0e38ad33c882
		displayFolder: Indicador

	/// Comparador obrigatorio: nunca exibir a UF sozinha (Constituicao 0.2).
	measure 'Valor no Brasil' = AVERAGE(fct_indicador_uf_ano[valor_brasil])
		formatString: #,0.00
		lineageTag: 1116f070-d304-1d6d-8dea-c4578d9b3f73
		displayFolder: Indicador

	/// Media simples entre as UFs da regiao — comparador de contexto, nao agregado ponderado.
	measure 'Valor na regiao' = AVERAGE(fct_indicador_uf_ano[valor_regiao])
		formatString: #,0.00
		lineageTag: e61638bc-6877-e920-c258-b6374c3449c1
		displayFolder: Indicador

