table dim_candidato
	/// Retrato da pessoa na eleicao em que concorreu. Chave: sk_candidatura.
	lineageTag: d1ffedf0-6f90-a453-34a9-c829b710e6d7

	/// Mediana, nao media: a distribuicao de idade e' assimetrica.
	measure 'Idade mediana' = MEDIAN(dim_candidato[idade_na_posse_valida])
		formatString: #,0
		lineageTag: 97ff8462-a150-ae1e-7cf0-27cd89b06688
		displayFolder: Perfil

	/// Quanto da trajetoria exibida nao depende do fallback nome+nascimento.
	measure '% com identidade confirmada por CPF' = DIVIDE(CALCULATE(COUNTROWS(dim_candidato), dim_candidato[link_confiavel] = TRUE), COUNTROWS(dim_candidato))
		formatString: 0.0%
		lineageTag: fe674ba9-56dc-ec64-8f95-419f7a3fbcac
		displayFolder: Qualidade

	/// (ano_eleicao, sg_ue, sq_candidato). `sq_candidato` sozinho nao serve: so' e' global a partir de 2010.
	column sk_candidatura
		dataType: string
		isHidden
		lineageTag: 0853943a-6c29-1ab4-a2da-4b2319a48793
		summarizeBy: none
		sourceColumn: sk_candidatura

		annotation SummarizationSetBy = Automatic

	column sq_candidato
		dataType: string
		isHidden
		lineageTag: 716e120e-8b7f-f8f0-4c8e-a3fc9d116f79
		summarizeBy: none
		sourceColumn: sq_candidato

		annotation SummarizationSetBy = Automatic

	column ano_eleicao
		dataType: int64
		isHidden
		lineageTag: f1838d88-be0f-7cdf-83f8-6c043b618aee
		summarizeBy: none
		sourceColumn: ano_eleicao

		annotation SummarizationSetBy = Automatic

	column id_pessoa
		dataType: string
		isHidden
		lineageTag: e1c0f770-d619-3891-1fe2-2173f1d0d121
		summarizeBy: none
		sourceColumn: id_pessoa

		annotation SummarizationSetBy = Automatic

	/// FALSE quando a identidade veio do fallback nome+nascimento.
	column link_confiavel
		dataType: boolean
		lineageTag: 4dbc8f5c-8b4d-63aa-5a02-d12161852543
		summarizeBy: none
		sourceColumn: link_confiavel

